{
  "name": "ems-server",
  "version": "1.0.0",
  "private": true,
  "description": "Company-Level Employee Management System - REST API (Node.js + Express + MongoDB Atlas)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "db:check": "node scripts/db-check.js",
    "db:setup": "bash scripts/atlas-setup.sh",
    "test:e2e": "node scripts/e2e-flow.js",
    "db:sync-counters": "node scripts/sync-counters.js",
    "test:surface": "node scripts/smoke-ui-surface.js",
    "test:modules": "node scripts/module-lifecycle.js",
    "test:full": "node scripts/full-suite.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
