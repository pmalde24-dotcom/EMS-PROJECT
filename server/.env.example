# ── EMS server environment ──────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — ખાલી રાખો તો in-memory demo mode (ડેમો ડેટા સાથે) ચાલશે
MONGODB_URI=
# ઉદાહરણ: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ems?retryWrites=true&w=majority
# સ્થાનિક:  mongodb://127.0.0.1:27017/ems

# JWT — production માં ચોક્કસ બદલો! (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false

# પહેલી સીડિંગ વખતના સુપર એડમિન
SEED_SUPER_ADMIN_EMAIL=superadmin@company.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_DATA=true
# production માં ડેટાબેઝ વગર ચલાવવું હોય (Render free tier demo) તો true કરો:
ALLOW_DEMO_MODE=false

# Cloudinary (વૈકલ્પિક — ખાલી રાખો તો uploads/ ફોલ્ડરમાં લોકલ સ્ટોર)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (વૈકલ્પિક — ખાલી રાખો તો ઈમેલ કન્સોલમાં [dev-mail] લખાય)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EMS <no-reply@company.com>
